{
  "name": "tendly-api",
  "version": "1.0.0",
  "description": "Tendly HRMS API Server",
  "main": "dist/lambda.js",
  "scripts": {
    "build": "tsc",
    "postinstall": "node scripts/install-puppeteer-browser.js",
    "postbuild": "npm run copy-templates",
    "copy-templates": "node scripts/copy-templates.js",
    "start": "ts-node src/local.ts",
    "dev": "nodemon src/local.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "package": "NODE_ENV=production npm install && NODE_ENV=production npm run build && NODE_ENV=production npm prune --production && rm -rf node_modules/argon2 && zip -r function.zip dist/* node_modules/* package.json",
    "deploy": "NODE_ENV=production npm run package && aws lambda update-function-code --function-name tendly-api --zip-file fileb://function.zip",
    "generate-data": "ts-node scripts/generateTrainingData.ts",
    "db:verify": "node scripts/verify-database.js",
    "db:migrate": "node scripts/migrate-to-production-db.js",
    "db:migrate:dry-run": "node scripts/migrate-to-production-db.js --dry-run",
    "db:clone": "ts-node scripts/simpleCloneDatabase.ts",
    "db:clone:advanced": "ts-node scripts/cloneDatabase.ts",
    "set-project": "gcloud config set project zuno-hr-2025",
    "hrms-build": "docker build -t zuno-cd-hr-india .",
    "hrms-tag": "docker tag zuno-cd-hr-india gcr.io/zuno-hr-2025/zuno-cd-hr-india",
    "hrms-push": "docker push gcr.io/zuno-hr-2025/zuno-cd-hr-india",
    "hrms-deploy": "gcloud run deploy zuno-cd-hr-india --image gcr.io/zuno-hr-2025/zuno-cd-hr-india:latest --platform managed --region asia-south1 --allow-unauthenticated --port 5800  --execution-environment gen2 --memory 512Mi --cpu 1",
    "full-deploy": "npm run set-project && npm run hrms-build && npm run hrms-tag && npm run hrms-push && npm run hrms-deploy"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^3.5.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^9.0.2",
    "@fastify/mongodb": "^8.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@google-cloud/storage": "^7.17.1",
    "@sinclair/typebox": "^0.34.49",
    "@types/multer": "^1.4.12",
    "@types/unzipper": "^0.10.11",
    "argon2": "^0.41.1",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "docxtemplater": "^3.60.2",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "fastify-multer": "^2.0.3",
    "firebase-admin": "^13.4.0",
    "fs": "^0.0.1-security",
    "handlebars": "^4.7.8",
    "json-2-csv": "^5.5.9",
    "json2csv": "^6.0.0-alpha.2",
    "libreoffice-convert": "^1.6.1",
    "mongodb": "^6.18.0",
    "mongoose": "^7.6.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "path": "^0.12.7",
    "pizzip": "^3.1.8",
    "puppeteer": "^24.4.0",
    "unzipper": "^0.12.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/date-fns": "^2.5.3",
    "@types/jest": "^29.5.6",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^20.17.28",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
