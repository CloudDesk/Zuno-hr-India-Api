<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2>New Resignation Submitted</h2>
  <p>Dear {{adminName}},</p>

  <p>{{employeeName}} has submitted a resignation request.</p>

  <ul>
    <li><strong>Submitted On:</strong> {{submittedDate}}</li>
    {{#if preferredLastWorkingDay}}
      <li><strong>Preferred Last Working Day:</strong> {{preferredLastWorkingDay}}</li>
    {{/if}}
    <li><strong>Reason:</strong> {{summary}}</li>
    {{#if remarks}}
      <li><strong>Remarks:</strong> {{remarks}}</li>
    {{/if}}
  </ul>

  <p>Please log in to the Zuno HR portal to review the request.</p>

  <p>Regards,<br />{{companyName}} Zuno HR</p>
</div>
