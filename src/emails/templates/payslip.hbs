<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payslip for {{payMonth}} {{payYear}}</title>
    <style>
        /* ── Reset ── */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            color: #000;
            background: #fff;
            padding: 4px 6px;
            line-height: 1.2;
        }

        /* ══════════════════════════
       OUTER WRAPPER
    ══════════════════════════ */
        .slip {
            width: 100%;
            border: 1.5px solid #000;
        }

        /* ══════════════════════════
       HEADER
    ══════════════════════════ */


        .co-name {
            font-family: "Times New Roman", Times, serif;
            font-size: 13pt;
            font-weight: bold;
            line-height: 1.2;
            margin-bottom: 2px;
            letter-spacing: 0.01em;
        }

        .co-addr {
            font-family: "Times New Roman", Times, serif;
            font-size: 8pt;
            font-weight: normal;
            color: #000;
            line-height: 1.6;
            white-space: nowrap;
        }

        .header-spacer {
            width: 170px;
            /* mirrors logo column to keep center perfectly balanced */
        }

        .slip-title {
            font-family: "Times New Roman", Times, serif;
            font-size: 11pt;
            font-weight: bold;
            text-align: center;
        }

        /* ══════════════════════════
       EMPLOYEE DETAILS TABLE
       — no inner borders at all (no row lines, no col lines)
       — only the outer slip border wraps it
       — labels: normal weight, Times New Roman 9pt
    ══════════════════════════ */
        table.emp-table {
            width: 100%;
            border-collapse: collapse;
            /* bottom separator before Earnings section */
            border-bottom: 1.5px solid #000;
        }

        table.emp-table td {
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            font-weight: normal;
            padding: 2px 8px;
            border: none;
        }

        /* Divider column */
        table.emp-table td.divider {
            border-right: 1.5px solid #000 !important;
        }

        /* column widths */
        table.emp-table col.c1 {
            width: 25%;
        }

        table.emp-table col.c2 {
            width: 25%;
        }

        table.emp-table col.c3 {
            width: 22%;
        }

        table.emp-table col.c4 {
            width: 28%;
        }

        /* ══════════════════════════
       EARNINGS + DEDUCTIONS
    ══════════════════════════ */
        .pay-wrap {
            display: flex;
            /* bottom line separating pay section from net pay */
            border-bottom: 1.5px solid #000;
        }

        /* Left: Earnings (50%) */
        .earnings-side {
            flex: 0 0 50%;
            /* vertical divider between earnings and deductions */
            border-right: 1.5px solid #000;
            display: flex;
            flex-direction: column;
        }

        /* Right: Deductions (remaining 50%) */
        .deductions-side {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .pay-body {
            flex: 1;
        }

        /* Column header row — bold, bottom border only */
        .pay-header {
            display: flex;
            align-items: center;
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            font-weight: bold;
            padding: 4px 10px;
            border-bottom: 1.5px solid #000;
        }

        .pay-header .col-label {
            flex: 1;
            white-space: nowrap;
        }

        .pay-header .col-full {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        .pay-header .col-act {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        .pay-header .col-ded {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        /* Data rows — NO borders between rows */
        .pay-row {
            display: flex;
            align-items: center;
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            font-weight: normal;
            padding: 3px 10px;
            min-height: 20px;
            /* no border-bottom — clean, no inner row lines */
        }

        .pay-row .col-label {
            flex: 1;
            white-space: nowrap;
        }

        .pay-row .col-full {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        .pay-row .col-act {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        .pay-row .col-ded {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        /* Totals row — top border only (separates items from total) */
        .pay-total {
            display: flex;
            align-items: center;
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            font-weight: bold;
            padding: 4px 10px;
            border-top: 1.5px solid #000;
        }

        .pay-total .col-label {
            flex: 1;
            white-space: nowrap;
        }

        .pay-total .col-full {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        .pay-total .col-act {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        .pay-total .col-ded {
            width: 88px;
            text-align: right;
            padding-right: 15px;
        }

        /* ══════════════════════════
       NET PAY SECTION
    ══════════════════════════ */
        .net-pay-row {
            display: flex;
            align-items: center;
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            padding: 5px 10px;
        }

        .net-label {
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            font-weight: normal;
        }

        .net-amount {
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            font-weight: bold;
            text-align: right;
        }

        .net-words-row {
            font-family: "Times New Roman", Times, serif;
            font-size: 9pt;
            font-style: italic;
            font-weight: normal;
            padding: 4px 10px 6px;
        }

        /* ══════════════════════════
       FOOTER NOTE
    ══════════════════════════ */
        .footer-note {
            font-family: "Times New Roman", Times, serif;
            font-size: 8.5pt;
            text-align: center;
            padding: 8px 10px;
            color: #000;
        }
    </style>
</head>

<body>

    <div class="slip">

        <!-- ── HEADER ── -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0"
            style="border-bottom: 1.5px solid #000; border-collapse: collapse; table-layout: fixed;">
            <tr>
                <!-- Left: Logo cell -->
                <td width="170" style="padding: 4px 10px; vertical-align: middle; text-align: center;">
                    <img src="https://storage.googleapis.com/tendlylogo/cd_logo_2%20(1).png"
                        style="width: 160px; height: auto; display: block; margin: 0 auto;">
                </td>

                <!-- Centre: Company details and Payslip title -->
                <td style="padding: 4px 0; vertical-align: middle; text-align: center;">
                    <div class="co-name">Cloud Desk Technology Private Limited</div>
                    <div class="co-addr">
                        No: 51, TEK Meadows, Old Mahabalipuram Rd, Sholinganallur, Chennai, Tamilnadu - 600119
                    </div>
                    <div class="slip-title" style="margin-top: 4px;">Payslip for the month of {{payMonth}} {{payYear}}
                    </div>
                </td>

                <!-- Right: Mirror spacer for perfect centering -->
                <td width="170" style="padding: 4px 10px;"></td>
            </tr>
        </table>

        <!-- ── PAYSLIP TITLE ── -->

        <!-- ── EMPLOYEE DETAILS ── -->
        <table class="emp-table">
            <colgroup>
                <col class="c1" />
                <col class="c2" />
                <col class="c3" />
                <col class="c4" />
            </colgroup>
            <tr>
                <td>Name:</td>
                <td class="divider">{{empName}}</td>
                <td>Employee No:</td>
                <td>{{empNo}}</td>
            </tr>
            <tr>
                <td>Joining Date:</td>
                <td class="divider">{{empJoinDate}}</td>
                <td>Bank Name:</td>
                <td>{{bankName}}</td>
            </tr>
            <tr>
                <td>Designation:</td>
                <td class="divider">{{empRole}}</td>
                <td>Bank Account No:</td>
                <td>{{bankAccNo}}</td>
            </tr>
            <tr>
                <td>Department:</td>
                <td class="divider">{{empDept}}</td>
                <td>PAN Number:</td>
                <td>{{panNo}}</td>
            </tr>
            <tr>
                <td>Location:</td>
                <td class="divider">{{empLocation}}</td>
                <td>PF No:</td>
                <td>{{pfNo}}</td>
            </tr>
            <tr>
                <td>Effective Work Days:</td>
                <td class="divider">{{effectiveWorkDays}}</td>
                <td>PF UAN:</td>
                <td>{{pfUan}}</td>
            </tr>
            <tr>
                <td>LOP:</td>
                <td class="divider">{{lopDays}}</td>
                <td colspan="2"></td>
            </tr>
        </table>

        <!-- ── EARNINGS + DEDUCTIONS ── -->
        <div class="pay-wrap">

            <!-- Earnings Side -->
            <div class="earnings-side">
                <div class="pay-header">
                    <span class="col-label">Earnings</span>
                    <span class="col-full">Full</span>
                    <span class="col-act">Actual</span>
                </div>

                <div class="pay-body">
                    {{#each allEarnings}}
                    <div class="pay-row">
                        <span class="col-label">{{this.label}}</span>
                        <span class="col-full">{{this.fullAmount}}</span>
                        <span class="col-act">{{this.actualAmount}}</span>
                    </div>
                    {{/each}}
                </div>

                <div class="pay-total">
                    <span class="col-label">Total Earnings:</span>
                    <span class="col-full">{{income.fullTotal}}</span>
                    <span class="col-act">{{income.total}}</span>
                </div>
            </div>

            <!-- Deductions Side -->
            <div class="deductions-side">
                <div class="pay-header">
                    <span class="col-label">Deductions</span>
                    <span class="col-full"></span>
                    <span class="col-ded">Actual</span>
                </div>

                <div class="pay-body">
                    {{#each allDeductions}}
                    <div class="pay-row">
                        <span class="col-label">{{this.label}}</span>
                        <span class="col-full"></span>
                        <span class="col-ded">{{this.amount}}</span>
                    </div>
                    {{/each}}
                </div>

                <div class="pay-total">
                    <span class="col-label">Total Deductions:</span>
                    <span class="col-full"></span>
                    <span class="col-ded">{{deduction.total}}</span>
                </div>
            </div>

        </div><!-- /.pay-wrap -->

        <!-- ── NET PAY ── -->
        <div class="net-pay-row">
            <span class="net-label">Net Pay for the month ( Total Earnings - Total Deductions):</span>
            <span class="net-amount">{{netPay}}</span>
        </div>
        <div class="net-words-row">({{netPayWords}})</div>

    </div><!-- /.slip -->

    <div class="footer-note">This is a system generated payslip and does not require signature.</div>

</body>

</html>