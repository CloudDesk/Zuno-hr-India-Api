<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2>Your Leave Request has been {{status}}</h2>
  <p>Dear {{employeeName}},</p>

  <p>Your leave request has been <strong>{{status}}</strong> by {{approverName}}.</p>
  {{#if appliedOnBehalf}}
    <p style="color: #666; font-style: italic;">Note: This request was applied on your behalf by {{appliedByName}}.</p>
  {{/if}}

  <ul>
    <li><strong>Leave Type:</strong> {{leaveType}}</li>
    <li><strong>From:</strong> {{fromDate}}</li>
    <li><strong>To:</strong> {{toDate}}</li>
    <li><strong>Total Days:</strong> {{totalDays}}</li>
    {{#if appliedOnBehalf}}
      <li><strong>Applied By:</strong> {{appliedByName}} (on behalf)</li>
    {{/if}}
    <li><strong>Approved By:</strong> {{approverName}}</li>
    {{#if remarks}}
      <li><strong>Remarks:</strong> {{remarks}}</li>
    {{/if}}
  </ul>

  <p>You can log in to the Zuno HR portal to view details.</p>

  <p>Regards,</p>
  <p>{{companyName}} Zuno HR</p>
</div>
